{
  "name": "quainy-risk-replay",
  "version": "0.1.0",
  "description": "An open-source replay lab for testing AI workflow risk before release.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "quainy-risk-replay": "./cli/index.mjs"
  },
  "files": [
    "cli",
    "docs",
    "lib",
    "examples/sample-agent",
    "risk-replay.config.example.json",
    "install.sh",
    "install.ps1",
    "README.md",
    "PRODUCT_PLAN.md",
    "BUILD_CHECKLIST.md",
    "QUAINY_CONTEXT.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "risk-replay": "node cli/index.mjs",
    "sample:http-agent": "node examples/sample-agent/http-agent.mjs",
    "sample:command-agent": "node examples/sample-agent/command-agent.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^15.3.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
